generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int                  @id @default(autoincrement())
  passwordHash     String               @default("")
  email            String?              @unique
  name             String
  phone            String?              @unique
  role             String               @default("CUSTOMER")
  status           String               @default("PENDING_KYC")
  nationalId       String?              @unique
  selfieUrl        String?
  avatarUrl        String?
  passportUrl      String?
  address          String?
  employmentStatus String?
  kycStatus        String               @default("PENDING")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  auditLogs        AuditLog[]           @relation("UserLogs")
  financings       FinancingAgreement[]
  loanApplications LoanApplication[]
  savingsAccount   SavingsAccount?
  selectedVehicleId        Int?
  selectedVehicleCondition String?
  selectedVehiclePrice     Float?
  selectedVehicle          Vehicle?             @relation("UserSelectedVehicle", fields: [selectedVehicleId], references: [id])
  guarantor1Name           String?
  guarantor1Phone          String?
  guarantor1Email          String?
  guarantor1IdUrl          String?
  guarantor2Name           String?
  guarantor2Phone          String?
  guarantor2Email          String?
  guarantor2IdUrl          String?
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation("UserLogs", fields: [userId], references: [id])
}

model Vehicle {
  id               Int                  @id @default(autoincrement())
  make             String
  model            String
  year             Int
  price            Float
  status           String               @default("AVAILABLE")
  dealerId         Int?
  image            String?
  gallery          String[]
  type             String?
  tagline          String?
  category         String?
  rating           Float?               @default(0)
  specs            Json?
  features         String[]
  condition        Json?
  dealerDetails    Json?
  estimatedCosts   Json?
  verification     Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  financings       FinancingAgreement[]
  loanApplications LoanApplication[]
  selectedBy       User[]               @relation("UserSelectedVehicle")
}

model SavingsAccount {
  id             Int                  @id @default(autoincrement())
  userId         Int                  @unique
  balance        Float                @default(0)
  targetAmount   Float
  interestEarned Float                @default(0)
  status         String               @default("ACTIVE")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id])
  transactions   SavingsTransaction[]
}

model SavingsTransaction {
  id                Int            @id @default(autoincrement())
  accountId         Int
  amount            Float
  type              String
  status            String         @default("PENDING")
  reference         String?        @unique
  provider          String?
  providerRef       String?        @unique
  providerTime      String?
  providerDate      String?
  withdrawalPhone   String?
  withdrawalName    String?
  withdrawalBank    String?
  withdrawalAccount String?
  date              DateTime       @default(now())
  account           SavingsAccount @relation(fields: [accountId], references: [id])
}

model LoanApplication {
  id              Int      @id @default(autoincrement())
  userId          Int
  vehicleId       Int
  requestedAmount Float
  status          String   @default("PENDING")
  riskScore       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
  user            User     @relation(fields: [userId], references: [id])
}

model FinancingAgreement {
  id                 Int         @id @default(autoincrement())
  customerId         Int
  vehicleId          Int
  principalAmount    Float
  monthlyInstallment Float
  interestRate       Float
  startDate          DateTime    @default(now())
  endDate            DateTime
  status             String      @default("ACTIVE")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  vehicle            Vehicle     @relation(fields: [vehicleId], references: [id])
  user               User        @relation(fields: [customerId], references: [id])
  repayments         Repayment[]
}

model Repayment {
  id          Int                @id @default(autoincrement())
  agreementId Int
  amount      Float
  status      String             @default("PENDING")
  dueDate     DateTime
  paidDate    DateTime?
  createdAt   DateTime           @default(now())
  agreement   FinancingAgreement @relation(fields: [agreementId], references: [id])
}
